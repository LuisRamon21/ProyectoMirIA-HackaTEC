# Copia este archivo como .env y llena los valores.

# Direccion de la API (la usan las apps de Streamlit)
API_URL=http://localhost:8000

# Base de datos SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=bawi
DB_DRIVER=ODBC Driver 18 for SQL Server
# Vacios = entrar con el usuario de Windows
DB_USER=
DB_PASSWORD=

# Clave para firmar sesiones (minimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Correo para enviar el codigo al crear cuenta (Riego y Comunidad).
# Con Gmail usa una "contraseña de aplicación" (no la normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
